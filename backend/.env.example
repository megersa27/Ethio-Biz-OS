# EthioBiz MS backend configuration.
# Copy this file to .env and fill in real values. Never commit .env.

# Port the API server listens on.
PORT=5000

# runtime: "development" or "production".
NODE_ENV=development

# MongoDB connection string.
# Local development:
MONGODB_URI=mongodb://127.0.0.1:27017/ethioBiz
# MongoDB Atlas (production) example — replace <user>:<pass> and cluster host:
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ethiobiz?retryWrites=true&w=majority

# JWT signing secret. MUST be at least 32 characters of random data.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotate this secret if it has ever been exposed (e.g. committed to a repo).
JWT_SECRET=
