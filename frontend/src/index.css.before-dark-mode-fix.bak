
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&family=Noto+Sans+Ethiopic:wght@400;500;600;700&display=swap');

:root {
  font-family: 'DM Sans', 'Noto Sans Ethiopic', sans-serif;
  color: #17211d;
  background: #f6f8f6;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  --green: #176b4d;
  --green-dark: #10523b;
  --green-light: #e7f4ed;
  --text: #17211d;
  --muted: #78847d;
  --border: #e8ede9;
  --surface: #ffffff;
  --page: #f6f8f6;
  --radius: 14px;
}

:root[data-theme='dark'] {
  --green: #69e0a3;
  --green-dark: #9beec0;
  --green-light: rgba(105, 224, 163, 0.13);
  --text: #edf7f1;
  --muted: #b7c9c0;
  --border: rgba(148, 163, 184, 0.18);
  --surface: #18242d;
  --page: #0d1419;
  --panel-alt: #1d2d36;
  --soft: #22343d;
  --radius: 14px;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  min-height: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--page);
  color: var(--text);
}

:root[data-theme='dark'] body {
  background:
    radial-gradient(circle at top left, rgba(105, 224, 163, 0.08), transparent 30%),
    radial-gradient(circle at bottom right, rgba(75, 164, 255, 0.08), transparent 24%),
    var(--page);
}

body, button, input, select, textarea {
  font-family: 'DM Sans', 'Noto Sans Ethiopic', sans-serif;
}

button, input, select, textarea {
  font-size: inherit;
}

button {
  cursor: pointer;
}

button:focus-visible,
input:focus-visible,
select:focus-visible {
  outline: 3px solid #91c9ac;
  outline-offset: 2px;
}

a {
  color: inherit;
  text-decoration: none;
}

h1, h2, h3, h4, p {
  margin-top: 0;
}

h1, h2, h3, h4 {
  font-family: 'Manrope', 'Noto Sans Ethiopic', sans-serif;
}

#root {
  width: 100%;
  min-height: 100vh;
}

::selection {
  color: #fff;
  background: #176b4d;
}
